# .cbignore for Unity projects
# Ignore build, cache, and user-specific files
[L]ibrary/
[T]emp/
[O]bj/
[B]uild/
[B]uilds/
[U]serSettings/
# Ignore auto-generated files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.opendb
# Ignore logs
[L]ogs/
*.log
# Ignore package cache
[P]ackageCache/
# Ignore generated folders
[B]ee/
[A]rtifacts/
# Ignore crash reports
*.crash
# Ignore other Unity-specific files
*.swp
*.bak
*.orig
*.old
# Ignore Mac OS specific files
.DS_Store
# Ignore Windows specific files
Thumbs.db
# Ignore files without extension
# Ignore files without a dot in the name (no extension)
[^.]*
# Ignore specific file types
*.png
*.fbx
*.wav
*.dll
*.jpg
*.tif
*.pdb
*.gif
*.asset
*.json
*.dag
*.meta
*.prefab
*.txt
*.svg
*.xml
*.mp4
*.unitypackage
*.mat
*.json
*.anim
*.controller
*.mixer
*.unity
*.prefab
*.asset
*.giparams
*.physicmaterial
*.pdf
*.overrideController
*.mp3
*.ttf
*.csv
*.wlt
*.prefab (Unity prefab files)
*.mat (Unity material files)
*.fbx (3D model files)
*.wav (audio files)
*.ttf (font files)
*.png (image files)
*.jpg (image files)
*.meta (Unity metadata files)
*.asset (Unity asset files)
*.anim (Unity animation files)
*.controller (Unity animator controller files)
*.physicsMaterial (Unity physics material files)
*.dll (dynamic link library files)
*.json (JSON data files)